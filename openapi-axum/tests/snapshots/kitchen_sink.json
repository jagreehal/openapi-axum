{
  "components": {
    "schemas": {
      "Kind": {
        "enum": [
          "dog",
          "cat"
        ],
        "type": "string"
      },
      "NewPet": {
        "properties": {
          "age": {
            "format": "int32",
            "maximum": 30,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/Kind"
          },
          "name": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "type": "object"
      },
      "Pet": {
        "description": "A pet.",
        "properties": {
          "id": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "tag": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "Signup": {
        "properties": {
          "age": {
            "format": "int32",
            "minimum": 18,
            "type": "integer"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "age"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "key": {
        "in": "header",
        "name": "x-api-key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "kitchen sink",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/stats": {
      "get": {
        "operationId": "admin_stats",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              }
            },
            "description": "OK"
          }
        }
      },
      "post": {
        "operationId": "reset_stats",
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "summary": "Registered on the parent at the same path the nested router adds `GET` to."
      }
    },
    "/by-uuid/{id}": {
      "get": {
        "operationId": "by_uuid",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid input."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not found."
          }
        }
      }
    },
    "/counter": {
      "get": {
        "operationId": "counter",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "format": "int32",
                  "minimum": 0,
                  "type": "integer"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Liveness.",
        "tags": [
          "meta"
        ]
      }
    },
    "/old": {
      "get": {
        "deprecated": true,
        "operationId": "old",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "format": "int32",
